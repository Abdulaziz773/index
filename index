<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Genesys Station Lookup</title>
<style>
  :root{
    --bg:#0f1419;
    --panel:#161d26;
    --border:#26313d;
    --text:#e6edf3;
    --muted:#8b98a5;
    --accent:#3b9cff;
    --accent-dim:#1c5a99;
    --ok:#3fb950;
    --err:#f85149;
    --mono: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    min-height:100vh;
    background:var(--bg);
    color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Tahoma,Arial,sans-serif;
    display:flex;
    align-items:flex-start;
    justify-content:center;
    padding:48px 20px;
  }
  .wrap{width:100%;max-width:640px;}
  h1{
    font-size:20px;
    font-weight:600;
    margin:0 0 4px;
    letter-spacing:-0.01em;
  }
  .sub{
    color:var(--muted);
    font-size:13px;
    margin:0 0 28px;
  }
  .panel{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:10px;
    padding:20px;
    margin-bottom:16px;
  }
  .panel h2{
    font-size:12px;
    text-transform:uppercase;
    letter-spacing:.06em;
    color:var(--muted);
    margin:0 0 14px;
    font-weight:600;
  }
  label{
    display:block;
    font-size:13px;
    color:var(--muted);
    margin-bottom:6px;
  }
  .field{margin-bottom:14px;}
  .field:last-child{margin-bottom:0;}
  input[type=text], input[type=password], select{
    width:100%;
    background:#0d1218;
    border:1px solid var(--border);
    border-radius:7px;
    color:var(--text);
    padding:10px 12px;
    font-size:14px;
    font-family:var(--mono);
    outline:none;
    transition:border-color .15s;
  }
  input:focus, select:focus{border-color:var(--accent);}
  select{font-family:inherit;cursor:pointer;}
  .row{display:flex;gap:10px;}
  .row .field{flex:1;}
  .search-row{display:flex;gap:10px;margin-top:4px;}
  .search-row input{flex:1;}
  button{
    background:var(--accent);
    color:#fff;
    border:none;
    border-radius:7px;
    padding:10px 20px;
    font-size:14px;
    font-weight:600;
    cursor:pointer;
    white-space:nowrap;
    transition:background .15s;
  }
  button:hover{background:var(--accent-dim);}
  button:disabled{opacity:.5;cursor:not-allowed;}
  .result{
    display:none;
  }
  .result.show{display:block;}
  .result-row{
    display:flex;
    justify-content:space-between;
    padding:10px 0;
    border-bottom:1px solid var(--border);
    font-size:14px;
  }
  .result-row:last-child{border-bottom:none;}
  .result-label{color:var(--muted);}
  .result-value{
    font-family:var(--mono);
    text-align:left;
    direction:ltr;
  }
  .badge{
    display:inline-block;
    padding:2px 8px;
    border-radius:5px;
    font-size:11px;
    font-weight:600;
  }
  .badge.webrtc{background:rgba(63,185,80,.15);color:var(--ok);}
  .badge.other{background:rgba(139,148,165,.15);color:var(--muted);}
  .status{
    font-size:13px;
    margin-top:10px;
    display:none;
  }
  .status.show{display:block;}
  .status.loading{color:var(--muted);}
  .status.error{color:var(--err);}
  .toggle-link{
    color:var(--accent);
    font-size:12px;
    cursor:pointer;
    text-decoration:underline;
  }
  .history{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    margin-top:10px;
  }
  .history-chip{
    display:inline-flex;
    align-items:center;
    gap:8px;
    background:#0d1218;
    border:1px solid var(--border);
    color:var(--muted);
    font-size:12px;
    padding:5px 6px 5px 10px;
    border-radius:14px;
    transition:border-color .15s, color .15s;
  }
  .history-chip:hover{border-color:var(--accent);color:var(--text);}
  .history-chip .chip-main{
    display:flex;
    align-items:baseline;
    gap:6px;
    cursor:pointer;
    direction:ltr;
  }
  .history-chip .chip-user{
    font-family:var(--mono);
  }
  .history-chip .chip-time{
    font-size:10.5px;
    color:var(--muted);
    opacity:.75;
    white-space:nowrap;
  }
  .history-chip .chip-del{
    width:16px;height:16px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:50%;
    color:var(--muted);
    cursor:pointer;
    font-size:13px;
    line-height:1;
    transition:background .15s, color .15s;
  }
  .history-chip .chip-del:hover{background:rgba(248,81,73,.15);color:var(--err);}
  .history-clear{
    color:var(--muted);
    font-size:11px;
    cursor:pointer;
    text-decoration:underline;
    margin-top:8px;
    display:inline-block;
  }
  .result-actions{
    display:flex;
    justify-content:flex-end;
    gap:8px;
    margin-top:12px;
  }
  .copy-btn{
    background:transparent;
    border:1px solid var(--border);
    color:var(--muted);
    font-size:12px;
    padding:6px 12px;
    border-radius:6px;
  }
  .copy-btn:hover{border-color:var(--accent);color:var(--text);background:transparent;}
  .copy-btn.copied{border-color:var(--ok);color:var(--ok);}
  .tabs{
    display:flex;
    gap:4px;
    background:#0d1218;
    border:1px solid var(--border);
    border-radius:8px;
    padding:3px;
    margin-bottom:16px;
  }
  .tab{
    flex:1;
    text-align:center;
    padding:8px 10px;
    font-size:13px;
    font-weight:600;
    color:var(--muted);
    border-radius:6px;
    cursor:pointer;
    transition:background .15s, color .15s;
  }
  .tab.active{background:var(--accent);color:#fff;}
  .multi-result-item{
    border:1px solid var(--border);
    border-radius:8px;
    padding:12px;
    margin-top:10px;
  }
  .multi-result-item .result-row:first-child{padding-top:0;}
</style>
</head>
<body>
<div class="wrap">
  <h1>Genesys Station Lookup</h1>
  <p class="sub">Developed by Abdulaziz</p>

  <div class="panel">
    <h2>بيانات الاتصال (OAuth)</h2>
    <div class="row">
      <div class="field">
        <label>Region</label>
        <select id="region">
          <option value="mypurecloud.de">mypurecloud.de</option>
          <option value="mypurecloud.com">mypurecloud.com</option>
          <option value="mypurecloud.ie">mypurecloud.ie</option>
          <option value="mypurecloud.com.au">mypurecloud.com.au</option>
          <option value="mypurecloud.jp">mypurecloud.jp</option>
          <option value="usw2.pure.cloud">usw2.pure.cloud</option>
          <option value="cac1.pure.cloud">cac1.pure.cloud</option>
          <option value="euw2.pure.cloud">euw2.pure.cloud</option>
          <option value="apne2.pure.cloud">apne2.pure.cloud</option>
        </select>
      </div>
    </div>
    <div class="field">
      <label>Access Token</label>
      <input type="password" id="token" placeholder="eyJhbGc..." autocomplete="off">
    </div>
    <span class="toggle-link" onclick="document.getElementById('token').type = document.getElementById('token').type === 'password' ? 'text' : 'password'">إظهار/إخفاء</span>
  </div>

  <div class="panel">
    <div class="tabs">
      <div class="tab active" id="tabUserToDevice" onclick="switchTab('userToDevice')">Username → Device</div>
      <div class="tab" id="tabDeviceToUser" onclick="switchTab('deviceToUser')">Device → Username</div>
    </div>

    <!-- Mode 1: username -> device -->
    <div id="panelUserToDevice">
      <h2>البحث بـ Username</h2>
      <label>Username</label>
      <div class="search-row">
        <input type="text" id="username" placeholder="user@example.com" autocomplete="off">
        <button id="searchBtn" onclick="search()">بحث</button>
      </div>

      <div class="history" id="history"></div>
      <span class="history-clear" id="historyClear" onclick="clearHistory()">مسح السجل</span>

      <div class="status" id="status"></div>

      <div class="result" id="result">
        <div style="height:14px;"></div>
        <div class="result-row">
          <span class="result-label">الاسم</span>
          <span class="result-value" id="r_userName">—</span>
        </div>
        <div class="result-row">
          <span class="result-label">اسم الجهاز</span>
          <span class="result-value" id="r_stationName">—</span>
        </div>
        <div class="result-row">
          <span class="result-label">النوع</span>
          <span class="result-value" id="r_stationType">—</span>
        </div>
        <div class="result-row">
          <span class="result-label">Station ID</span>
          <span class="result-value" id="r_stationId">—</span>
        </div>
        <div class="result-actions">
          <button class="copy-btn" id="copyNameBtn" onclick="copyStationName()">نسخ اسم الجهاز</button>
          <button class="copy-btn" id="copyJsonBtn" onclick="copyAllJson()">نسخ الكل (JSON)</button>
        </div>
      </div>
    </div>

    <!-- Mode 2: device -> username -->
    <div id="panelDeviceToUser" style="display:none;">
      <h2>البحث بـ اسم الجهاز</h2>
      <label>اسم الجهاز (أو جزء منه)</label>
      <div class="search-row">
        <input type="text" id="deviceName" placeholder="مثال: 1006 أو WebRTC" autocomplete="off">
        <button id="searchDeviceBtn" onclick="searchByDevice()">بحث</button>
      </div>

      <div class="history" id="deviceHistory"></div>
      <span class="history-clear" id="deviceHistoryClear" onclick="clearDeviceHistory()">مسح السجل</span>

      <div class="status" id="deviceStatus"></div>

      <div id="deviceResults"></div>
    </div>
  </div>
</div>

<script>
const STATION_TYPE_LABELS = {
  'inin_webrtc_softphone': { text: 'WebRTC Softphone', cls: 'webrtc' },
  'inin_softphone': { text: 'Softphone (Desktop App)', cls: 'webrtc' },
  'inin_remote': { text: 'Remote Phone', cls: 'other' },
  'inin_bcp': { text: 'Physical Desk Phone', cls: 'other' }
};

function switchTab(mode) {
  const isUserToDevice = mode === 'userToDevice';
  document.getElementById('panelUserToDevice').style.display = isUserToDevice ? 'block' : 'none';
  document.getElementById('panelDeviceToUser').style.display = isUserToDevice ? 'none' : 'block';
  document.getElementById('tabUserToDevice').classList.toggle('active', isUserToDevice);
  document.getElementById('tabDeviceToUser').classList.toggle('active', !isUserToDevice);
}

function setStatus(msg, type, elId) {
  const el = document.getElementById(elId || 'status');
  el.textContent = msg;
  el.className = 'status show ' + (type || '');
}

function clearStatus(elId) {
  const el = document.getElementById(elId || 'status');
  el.className = 'status';
  el.textContent = '';
}

// ---- Search history (localStorage) ----
const HISTORY_KEY = 'genesys_lookup_history';
const DEVICE_HISTORY_KEY = 'genesys_device_lookup_history';
const HISTORY_MAX = 50;
let lastResult = null;

function loadHistory(key) {
  try {
    const raw = JSON.parse(localStorage.getItem(key) || '[]');
    // Backward compatibility: older versions stored plain strings
    return raw.map(item => typeof item === 'string' ? { value: item, ts: Date.now() } : item);
  } catch (e) {
    return [];
  }
}

function saveToHistory(key, value) {
  let hist = loadHistory(key).filter(h => h.value !== value);
  hist.unshift({ value, ts: Date.now() });
  hist = hist.slice(0, HISTORY_MAX);
  localStorage.setItem(key, JSON.stringify(hist));
  renderHistoryFor(key);
}

function deleteHistoryItem(key, index) {
  let hist = loadHistory(key);
  hist.splice(index, 1);
  localStorage.setItem(key, JSON.stringify(hist));
  renderHistoryFor(key);
}

function clearHistory() {
  localStorage.removeItem(HISTORY_KEY);
  renderHistoryFor(HISTORY_KEY);
}

function clearDeviceHistory() {
  localStorage.removeItem(DEVICE_HISTORY_KEY);
  renderHistoryFor(DEVICE_HISTORY_KEY);
}

function relativeTime(ts) {
  const diffSec = Math.floor((Date.now() - ts) / 1000);
  if (diffSec < 10) return 'الآن';
  if (diffSec < 60) return `منذ ${diffSec} ث`;
  const diffMin = Math.floor(diffSec / 60);
  if (diffMin < 60) return `منذ ${diffMin} د`;
  const diffHr = Math.floor(diffMin / 60);
  if (diffHr < 24) return `منذ ${diffHr} س`;
  const diffDay = Math.floor(diffHr / 24);
  return `منذ ${diffDay} ي`;
}

function renderHistoryFor(key) {
  const isDevice = key === DEVICE_HISTORY_KEY;
  const hist = loadHistory(key);
  const el = document.getElementById(isDevice ? 'deviceHistory' : 'history');
  const clearLink = document.getElementById(isDevice ? 'deviceHistoryClear' : 'historyClear');
  const targetInputId = isDevice ? 'deviceName' : 'username';
  const runFn = isDevice ? searchByDevice : search;

  el.innerHTML = '';
  if (hist.length === 0) {
    clearLink.style.display = 'none';
    return;
  }
  clearLink.style.display = 'inline-block';
  hist.forEach((item, index) => {
    const chip = document.createElement('span');
    chip.className = 'history-chip';

    const main = document.createElement('span');
    main.className = 'chip-main';
    main.title = new Date(item.ts).toLocaleString();
    main.onclick = () => {
      document.getElementById(targetInputId).value = item.value;
      runFn();
    };

    const userSpan = document.createElement('span');
    userSpan.className = 'chip-user';
    userSpan.textContent = item.value;

    const timeSpan = document.createElement('span');
    timeSpan.className = 'chip-time';
    timeSpan.textContent = relativeTime(item.ts);

    main.appendChild(userSpan);
    main.appendChild(timeSpan);

    const del = document.createElement('span');
    del.className = 'chip-del';
    del.textContent = '×';
    del.title = 'حذف';
    del.onclick = (e) => {
      e.stopPropagation();
      deleteHistoryItem(key, index);
    };

    chip.appendChild(main);
    chip.appendChild(del);
    el.appendChild(chip);
  });
}

function renderHistory() {
  renderHistoryFor(HISTORY_KEY);
  renderHistoryFor(DEVICE_HISTORY_KEY);
}

// ---- Copy actions ----
function flashCopied(btnId, originalText) {
  const btn = document.getElementById(btnId);
  btn.textContent = 'تم النسخ ✓';
  btn.classList.add('copied');
  setTimeout(() => {
    btn.textContent = originalText;
    btn.classList.remove('copied');
  }, 1500);
}

function copyStationName() {
  if (!lastResult) return;
  navigator.clipboard.writeText(lastResult.station_name || '').then(() => {
    flashCopied('copyNameBtn', 'نسخ اسم الجهاز');
  });
}

function copyAllJson() {
  if (!lastResult) return;
  navigator.clipboard.writeText(JSON.stringify(lastResult, null, 2)).then(() => {
    flashCopied('copyJsonBtn', 'نسخ الكل (JSON)');
  });
}

async function search() {
  const region = document.getElementById('region').value;
  const token = document.getElementById('token').value.trim();
  const username = document.getElementById('username').value.trim();
  const btn = document.getElementById('searchBtn');
  const resultEl = document.getElementById('result');

  resultEl.classList.remove('show');
  clearStatus();
  lastResult = null;

  if (!token) { setStatus('أدخل الـ Access Token أولاً', 'error'); return; }
  if (!username) { setStatus('أدخل username', 'error'); return; }

  btn.disabled = true;
  setStatus('جاري البحث...', 'loading');

  try {
    // Step 1: user search with station expand
    const searchResp = await fetch(`https://api.${region}/api/v2/users/search`, {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        pageSize: 1,
        query: [{ type: 'EXACT', fields: ['username'], value: username }],
        expand: ['station']
      })
    });

    if (!searchResp.ok) {
      const errText = await searchResp.text();
      throw new Error(`خطأ ${searchResp.status}: ${errText.slice(0, 200)}`);
    }

    const searchData = await searchResp.json();
    const user = (searchData.results || [])[0];

    if (!user) {
      setStatus('المستخدم غير موجود', 'error');
      btn.disabled = false;
      return;
    }

    const stationRef = user.station && (user.station.effectiveStation || user.station.associatedStation);

    if (!stationRef) {
      setStatus('لا يوجد جهاز (station) مرتبط بهذا المستخدم', 'error');
      document.getElementById('r_userName').textContent = user.name || '—';
      document.getElementById('r_stationName').textContent = '—';
      document.getElementById('r_stationType').textContent = '—';
      document.getElementById('r_stationId').textContent = '—';
      resultEl.classList.add('show');
      btn.disabled = false;
      return;
    }

    // Step 2: get station details
    const stationResp = await fetch(`https://api.${region}/api/v2/stations/${stationRef.id}`, {
      headers: { 'Authorization': `Bearer ${token}` }
    });

    if (!stationResp.ok) {
      const errText = await stationResp.text();
      throw new Error(`خطأ ${stationResp.status}: ${errText.slice(0, 200)}`);
    }

    const stationData = await stationResp.json();
    const typeInfo = STATION_TYPE_LABELS[stationData.type] || { text: stationData.type || '—', cls: 'other' };

    document.getElementById('r_userName').textContent = user.name || '—';
    document.getElementById('r_stationName').textContent = stationData.name || '—';
    document.getElementById('r_stationType').innerHTML = `<span class="badge ${typeInfo.cls}">${typeInfo.text}</span>`;
    document.getElementById('r_stationId').textContent = stationData.id || '—';

    lastResult = {
      user_name: user.name || null,
      username: username,
      station_id: stationData.id || null,
      station_name: stationData.name || null,
      station_type: stationData.type || null
    };
    saveToHistory(HISTORY_KEY, username);

    resultEl.classList.add('show');
    clearStatus();

  } catch (err) {
    setStatus(err.message || 'حدث خطأ غير متوقع', 'error');
  } finally {
    btn.disabled = false;
  }
}

document.getElementById('username').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') search();
});

// ---- Reverse search: device name -> username ----
async function searchByDevice() {
  const region = document.getElementById('region').value;
  const token = document.getElementById('token').value.trim();
  const deviceName = document.getElementById('deviceName').value.trim();
  const btn = document.getElementById('searchDeviceBtn');
  const resultsEl = document.getElementById('deviceResults');

  resultsEl.innerHTML = '';
  clearStatus('deviceStatus');

  if (!token) { setStatus('أدخل الـ Access Token أولاً', 'error', 'deviceStatus'); return; }
  if (!deviceName) { setStatus('أدخل اسم الجهاز', 'error', 'deviceStatus'); return; }

  btn.disabled = true;
  setStatus('جاري البحث...', 'loading', 'deviceStatus');

  try {
    // Step 1: find stations matching the name
    const stationsResp = await fetch(`https://api.${region}/api/v2/stations?name=${encodeURIComponent(deviceName)}&pageSize=25`, {
      headers: { 'Authorization': `Bearer ${token}` }
    });

    if (!stationsResp.ok) {
      const errText = await stationsResp.text();
      throw new Error(`خطأ ${stationsResp.status}: ${errText.slice(0, 200)}`);
    }

    const stationsData = await stationsResp.json();
    const stations = stationsData.entities || [];

    if (stations.length === 0) {
      setStatus('لا يوجد جهاز يطابق هذا الاسم', 'error', 'deviceStatus');
      btn.disabled = false;
      return;
    }

    // Step 2: resolve each station's userId to a user name (in parallel)
    const enriched = await Promise.all(stations.map(async (st) => {
      if (!st.userId) {
        return { station: st, userName: null };
      }
      try {
        const userResp = await fetch(`https://api.${region}/api/v2/users/${st.userId}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!userResp.ok) return { station: st, userName: null };
        const userData = await userResp.json();
        return { station: st, userName: userData.name || null, username: userData.username || null };
      } catch (e) {
        return { station: st, userName: null };
      }
    }));

    resultsEl.innerHTML = '';
    enriched.forEach(({ station, userName, username }) => {
      const typeInfo = STATION_TYPE_LABELS[station.type] || { text: station.type || '—', cls: 'other' };
      const item = document.createElement('div');
      item.className = 'multi-result-item';
      item.innerHTML = `
        <div class="result-row">
          <span class="result-label">اسم الجهاز</span>
          <span class="result-value">${station.name || '—'}</span>
        </div>
        <div class="result-row">
          <span class="result-label">المستخدم</span>
          <span class="result-value">${userName || (station.userId ? 'غير معروف' : 'لا يوجد مستخدم مرتبط')}</span>
        </div>
        ${username ? `<div class="result-row"><span class="result-label">Username</span><span class="result-value">${username}</span></div>` : ''}
        <div class="result-row">
          <span class="result-label">النوع</span>
          <span class="result-value"><span class="badge ${typeInfo.cls}">${typeInfo.text}</span></span>
        </div>
        <div class="result-row">
          <span class="result-label">Station ID</span>
          <span class="result-value">${station.id || '—'}</span>
        </div>
      `;
      resultsEl.appendChild(item);
    });

    saveToHistory(DEVICE_HISTORY_KEY, deviceName);
    clearStatus('deviceStatus');

  } catch (err) {
    setStatus(err.message || 'حدث خطأ غير متوقع', 'error', 'deviceStatus');
  } finally {
    btn.disabled = false;
  }
}

document.getElementById('deviceName').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') searchByDevice();
});

renderHistory();
setInterval(renderHistory, 30000);
</script>
</body>
</html>
